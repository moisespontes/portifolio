							<span class="form-error" data-error-for="name"></span>
						</div>
						<div class="form-group">
							<label for="email">E-mail</label>
							<input type="email" id="email" name="email" placeholder="seu@email.com"/>
							<span class="form-error" data-error-for="email"></span>
						</div>
					</div>
					<div class="form-group">
						<label for="subject">Assunto</label>
						<input type="text" id="subject" name="subject" placeholder="Sobre o que vamos conversar?"/>
						<span class="form-error" data-error-for="subject"></span>
					</div>
					<div class="form-group">
						<label for="message">Mensagem</label>
						<textarea id="message" name="message" placeholder="Conte-me um pouco sobre seu projeto..."></textarea>
						<span class="form-error" data-error-for="message"></span>
					</div>
					<button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">
						<ion-icon name="send-outline"></ion-icon>
						Enviar mensagem
					</button>
					<p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
				</form>
			</div>
		</section>

	</main>
{% endblock %}

{% block scripts %}
	<script src="{{ asset('js/script.js') }}"></script>
{% endblock %}
